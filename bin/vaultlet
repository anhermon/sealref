#!/bin/sh
# Resolve the package dir from this script's real location so vaultlet works
# from any cwd, and through a symlink on PATH.
self=$0
while [ -L "$self" ]; do self=$(readlink "$self"); done
root=$(cd "$(dirname "$self")/.." && pwd)
PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m vaultlet "$@"
